# See https://help.github.com/articles/ignoring-files/

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Vercel
.vercel

# Environment variables
.env*
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/settings.json
.idea/

# Misc
*.pem
.vercel

# DEBUG_AS_OF_ROUND trimmed data (generated)
/.debug-data/

# Captured SuperCoach subscriber data: never commit
data/players-cf.json

# Local script output and Claude Code settings
/scripts/output/
/.claude/

# Past-season history downloads (raw, large); the compact
# data/history/matchups-*.json files are committed.
/data/history/*/
