# Copy to .env.local for local development. Names only; leave values empty
# unless you need them. Never commit real values.

# Debug lock: show the site as it was straight after this round (1-24),
# e.g. 10. Unset = normal behaviour. Do not set this on Vercel. To lock only
# the local dev server, put it in .env.development.local (read by next dev,
# never by next build), or use npm run dev:r10 / npm run dev:live.
DEBUG_AS_OF_ROUND=

# Set to "true" to show /magic-number, /engine and /debug on Vercel production
# and preview deployments (they are hidden there by default; always shown
# locally).
SHOW_INTERNAL_PAGES=

# Public site URL for metadata, link previews and share links (no trailing
# path). Defaults to https://supercoach-toolkit.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=
