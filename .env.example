# Copy to .env.local for local development. Names only; leave values empty
# unless you need them. Never commit real values.

# Debug lock: show the site as it was straight after this round (1-24).
# Unset = normal behaviour. Do not set this on Vercel.
DEBUG_AS_OF_ROUND=

# Set to "true" to show /magic-number, /engine and /debug on the production
# deployment (they are hidden there by default).
SHOW_INTERNAL_PAGES=
