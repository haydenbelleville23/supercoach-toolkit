{
  "name": "supercoach-projector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:r10": "node scripts/dev.mjs --round 10",
    "dev:live": "node scripts/dev.mjs --live",
    "dev:2027": "node scripts/dev.mjs --season 2027",
    "build": "set NODE_OPTIONS=--max-old-space-size=8192 && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "download:players": "node scripts/downloadPlayerDetails.mjs",
    "build:players": "node scripts/buildPlayersDataset.mjs && node scripts/build-players-normalised.ts",
    "download:fixtures": "node scripts/downloadFixtures.mjs",
    "update:weekly": "node scripts/update-weekly.mjs",
    "download:history": "node scripts/downloadHistory.mjs",
    "build:history": "node scripts/buildHistory.mjs",
    "accuracy:log": "node scripts/accuracy-log.ts",
    "backtest:as-of": "node scripts/as-of-backtest.ts",
    "build:games": "node scripts/build-games.ts",
    "import:availability": "node scripts/import-availability.ts",
    "import:fixtures": "node scripts/import-fixtures.ts",
    "generate:sample-fixtures": "node scripts/generate-sample-fixtures.ts",
    "live:snapshot": "node scripts/save-live-snapshot.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.25.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
